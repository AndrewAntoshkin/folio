{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@/lib/*": ["./lib/*"],
      "@/components/agent-ui/*": ["./registry/agent-ui/*"]
    }
  },
  "include": ["app", "lib", "registry"]
}
